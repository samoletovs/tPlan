/* Tplan — Original bare styles (pre-design-system) */
*{box-sizing:border-box;margin:0;padding:0}
:root{--bg:#f5f5f5;--card:#fff;--border:#e0e0e0;--text:#222;--muted:#888;--accent:#0d9668;--accent-bg:#e6f7f0;--red:#d63031;--orange:#e67e22;--blue:#2563eb;--blue-bg:#eff6ff;--warm-bg:#fff8f0;--cool-bg:#f0f4ff}
body{font-family:system-ui,-apple-system,sans-serif;background:var(--bg);color:var(--text);max-width:540px;margin:0 auto;padding:16px;min-height:100vh;font-size:18px}
h1{font-size:1.5em;margin-bottom:4px}
.sub{color:var(--muted);font-size:.9em;margin-bottom:20px}
.streak{text-align:center;padding:10px;background:var(--accent-bg);border-radius:10px;font-size:1em;font-weight:600;color:var(--accent);margin-bottom:16px}
.prog{display:flex;align-items:center;gap:10px;margin-bottom:20px}
.prog-bar{flex:1;height:8px;background:var(--border);border-radius:4px;overflow:hidden}
.prog-fill{height:100%;background:var(--accent);border-radius:4px;transition:width .4s}
.prog-text{font-size:.85em;color:var(--muted);white-space:nowrap}
.card{background:var(--card);border:1px solid var(--border);border-radius:14px;padding:20px;margin-bottom:14px;box-shadow:0 1px 3px rgba(0,0,0,.04)}
.card.active{border-color:var(--accent);box-shadow:0 2px 12px rgba(13,150,104,.12)}
.card.done{opacity:.55;border-color:var(--border);box-shadow:none}
.card.upcoming{opacity:.35}
.card h3{font-size:1.15em;margin-bottom:6px}
.card .meta{color:var(--muted);font-size:.9em;margin-bottom:10px}
.tech{background:var(--accent-bg);border-left:3px solid var(--accent);padding:10px 14px;font-size:.92em;color:#333;line-height:1.6;margin:10px 0;border-radius:0 6px 6px 0}
.prev-result{background:#fff8e1;border-left:3px solid #f9a825;padding:8px 12px;font-size:.9em;color:#6d4c00;line-height:1.5;margin:8px 0;border-radius:0 6px 6px 0}
.tag{display:inline-block;padding:3px 10px;border-radius:10px;font-size:.8em;font-weight:600;text-transform:uppercase;margin-bottom:8px}
.tag-warmup{background:var(--warm-bg);color:var(--orange)}
.tag-exercise{background:#ffeaea;color:var(--red)}
.tag-cooldown{background:var(--cool-bg);color:var(--blue)}
.check-item{display:flex;align-items:flex-start;gap:12px;padding:12px 0;border-bottom:1px solid var(--border);font-size:1em}
.check-item:last-child{border:none}
.check-item input[type="checkbox"]{width:24px;height:24px;accent-color:var(--accent);margin-top:2px;flex-shrink:0}
.check-item.checked .ci-text{text-decoration:line-through;color:var(--muted)}
.ci-content{flex:1}
.ci-text{display:block;font-weight:500;font-size:1em}
.ci-desc{display:block;font-size:.88em;color:var(--muted);margin-top:3px;line-height:1.5}
.ci-timer{display:inline-flex;align-items:center;gap:6px;margin-top:6px}
.ci-timer-btn{background:var(--accent);color:#fff;border:none;border-radius:8px;padding:6px 14px;font-size:.9em;font-weight:600;cursor:pointer}
.ci-timer-btn:active{transform:scale(.96)}
.ci-timer-btn.running{background:var(--orange)}
.ci-timer-btn.finished{background:#aaa}
.ci-timer-display{font-size:1.1em;font-weight:700;font-variant-numeric:tabular-nums;min-width:44px;color:var(--accent)}
.ci-timer-display.warn{color:var(--orange)}
.ci-timer-display.end{color:var(--red)}
.btn{display:block;width:100%;padding:14px;border:none;border-radius:12px;font-size:1.05em;font-weight:600;cursor:pointer;transition:all .15s}
.btn:active{transform:scale(.98)}
.btn-go{background:var(--accent);color:#fff}
.btn-go:hover{background:#0b8058}
.btn-save{background:var(--blue);color:#fff;margin-top:12px}
.btn-skip{background:transparent;color:var(--muted);border:1px solid var(--border);margin-top:6px}
.btn-tempo{background:var(--blue);color:#fff;margin-top:8px;font-size:.95em;padding:12px}
.timer{text-align:center;padding:16px 0}
.timer-display{font-size:4em;font-weight:700;font-variant-numeric:tabular-nums;color:var(--accent)}
.timer-display.warn{color:var(--orange)}
.timer-display.end{color:var(--red);animation:pulse .5s infinite alternate}
.timer-label{color:var(--muted);font-size:.95em;margin-bottom:6px}
@keyframes pulse{to{opacity:.4}}
.tempo-box{text-align:center;padding:12px 0;margin:8px 0}
.tempo-phase{font-size:2em;font-weight:700;margin-bottom:4px}
.tempo-phase.phase-down{color:var(--blue)}
.tempo-phase.phase-hold{color:var(--orange)}
.tempo-phase.phase-up{color:var(--accent)}
.tempo-count{font-size:1em;color:var(--muted)}
.reps-row{display:flex;align-items:center;gap:12px;margin:12px 0}
.reps-row label{font-size:.95em;color:var(--muted)}
.reps-input{background:var(--bg);border:1px solid var(--border);color:var(--text);border-radius:8px;padding:10px 14px;font-size:1.3em;width:90px;text-align:center;font-weight:700}
.reps-input:focus{outline:none;border-color:var(--accent)}
.note-input{background:var(--bg);border:1px solid var(--border);color:var(--text);border-radius:8px;padding:8px 12px;font-size:.85em;width:100%;margin-top:6px}
.note-input:focus{outline:none;border-color:var(--accent)}
.diff-row{display:flex;align-items:center;gap:8px;margin:12px 0;flex-wrap:wrap}
.diff-row label{font-size:.95em;color:var(--muted)}
.diff-btn{padding:8px 16px;border-radius:10px;border:1px solid var(--border);background:var(--bg);font-size:.95em;font-weight:600;cursor:pointer;transition:all .15s}
.diff-btn:hover{border-color:var(--accent)}
.diff-btn.selected{color:#fff}
.diff-btn.sel-easy{background:var(--accent);border-color:var(--accent)}
.diff-btn.sel-normal{background:var(--orange);border-color:var(--orange)}
.diff-btn.sel-hard{background:var(--red);border-color:var(--red)}
.weight-row{display:flex;align-items:center;gap:10px;margin:14px 0}
.weight-row label{font-size:.88em;color:var(--muted)}
.weight-input{background:var(--bg);border:1px solid var(--border);color:var(--text);border-radius:8px;padding:8px 12px;font-size:1.1em;width:90px;text-align:center;font-weight:700}
.weight-input:focus{outline:none;border-color:var(--accent)}
.weight-unit{font-size:.82em;color:var(--muted)}
.summary-table{width:100%;border-collapse:collapse;margin:12px 0}
.summary-table th,.summary-table td{padding:6px 8px;font-size:.82em;text-align:left;border-bottom:1px solid var(--border)}
.summary-table th{color:var(--muted);font-weight:500}
.good{color:var(--accent);font-weight:600}
.miss{color:var(--red);font-weight:600}
.final-notes{background:var(--bg);border:1px solid var(--border);color:var(--text);border-radius:8px;padding:10px;font-size:.85em;width:100%;min-height:60px;resize:vertical;margin-top:8px}
.final-notes:focus{outline:none;border-color:var(--accent)}
.prog-rec{background:var(--accent-bg);border:1px solid var(--accent);border-radius:10px;padding:12px;margin:12px 0;font-size:.85em;line-height:1.5}
.prog-rec strong{color:var(--accent)}
.hidden{display:none}
.done-badge{color:var(--accent);font-size:.75em;margin-left:6px}
.elapsed-timer{text-align:center;font-size:1.1em;color:var(--muted);margin-bottom:14px;font-variant-numeric:tabular-nums;letter-spacing:.03em}
.btn-start{background:var(--accent);color:#fff;font-size:1.2em;padding:18px;border-radius:14px;margin:20px 0;animation:pulse-start 2s infinite}
@keyframes pulse-start{0%,100%{box-shadow:0 0 0 0 rgba(13,150,104,.4)}70%{box-shadow:0 0 0 10px rgba(13,150,104,0)}}
.target-number{text-align:center;padding:16px 0 12px}
.target-number .num{font-size:3rem;font-weight:800;color:var(--accent);line-height:1;letter-spacing:-0.04em}
.target-number .label{font-size:.78rem;color:var(--muted);font-weight:600;text-transform:uppercase;letter-spacing:.06em;margin-top:4px}
