/* ============================================================
   Tplan — Design System v2
   Clarity · Calm · Craft
   ============================================================ */

@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

/* --- Tokens --- */
:root {
  --bg:           #F5F3EF;
  --bg-secondary: #EBE8E2;
  --card:         #FFFFFF;
  --border:       #E2DFD8;
  --border-strong:#CCC9C1;
  --text:         #1C1B18;
  --muted:        #78756D;
  --tertiary:     #A09D96;
  --accent:       #0D9668;
  --accent-hover: #0A7A54;
  --accent-bg:    #E6F7EF;
  --accent-glow:  rgba(13,150,104,0.10);
  --red:          #DC2626;
  --orange:       #D97706;
  --blue:         #2563EB;
  --blue-bg:      #EFF6FF;
  --warm-bg:      #FEF7E8;
  --cool-bg:      #EDF0FF;
  --exercise-bg:  #FEF0F0;
  --shadow-card:  0 1px 3px rgba(0,0,0,0.05), 0 1px 1px rgba(0,0,0,0.03);
  --shadow-active:0 8px 32px rgba(13,150,104,0.16), 0 0 0 2px var(--accent);
  --shadow-md:    0 4px 12px rgba(0,0,0,0.08);
  --radius:       16px;
  --radius-sm:    10px;
  --radius-xs:    6px;
  --radius-pill:  9999px;
  --ease:         cubic-bezier(0.25, 0.1, 0.25, 1);
  --ease-spring:  cubic-bezier(0.34, 1.56, 0.64, 1);
  --dur:          200ms;
  --dur-slow:     350ms;
}

@media (prefers-color-scheme: dark) {
  :root {
    --bg:           #0E0E0D;
    --bg-secondary: #181816;
    --card:         #1C1C1A;
    --border:       #2C2C28;
    --border-strong:#3C3C38;
    --text:         #ECEBE6;
    --muted:        #9C9990;
    --tertiary:     #6C6A64;
    --accent:       #34D399;
    --accent-hover: #6EE7B7;
    --accent-bg:    #0A291A;
    --accent-glow:  rgba(52,211,153,0.08);
    --red:          #F87171;
    --orange:       #FBBF24;
    --blue:         #60A5FA;
    --blue-bg:      #172033;
    --warm-bg:      #231F18;
    --cool-bg:      #171C2E;
    --exercise-bg:  #261C1C;
    --shadow-card:  0 0 0 1px var(--border);
    --shadow-active:0 0 0 2px var(--accent), 0 8px 32px rgba(52,211,153,0.12);
    --shadow-md:    none;
  }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    transition-duration: 0.01ms !important;
  }
}

/* --- Base --- */
body {
  font-family: 'Inter', system-ui, -apple-system, sans-serif;
  background: var(--bg);
  color: var(--text);
  max-width: 540px;
  margin: 0 auto;
  padding: 32px 20px;
  min-height: 100vh;
  font-size: 15px;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

h1 {
  font-size: 1.65rem;
  font-weight: 800;
  letter-spacing: -0.03em;
  line-height: 1.2;
  margin-bottom: 6px;
}

h2 {
  font-size: 1.35rem;
  font-weight: 700;
  letter-spacing: -0.02em;
}

.sub {
  color: var(--muted);
  font-size: 0.82rem;
  margin-bottom: 28px;
  line-height: 1.5;
  letter-spacing: 0.01em;
}

/* --- Streak Banner --- */
.streak {
  text-align: center;
  padding: 14px 20px;
  background: var(--accent-bg);
  border: 1px solid var(--accent);
  border-radius: var(--radius);
  font-size: 0.9rem;
  font-weight: 600;
  color: var(--accent);
  margin-bottom: 24px;
  letter-spacing: 0.01em;
}

/* --- Progress Bar --- */
.prog {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-bottom: 28px;
  padding: 0 2px;
}

.prog-bar {
  flex: 1;
  height: 8px;
  background: var(--bg-secondary);
  border-radius: var(--radius-pill);
  overflow: hidden;
  border: 1px solid var(--border);
}

.prog-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--accent), #34D399);
  border-radius: var(--radius-pill);
  transition: width 0.5s var(--ease);
}

.prog-text {
  font-size: 0.78rem;
  font-weight: 600;
  color: var(--muted);
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
}

/* --- Cards --- */
.card {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 24px;
  margin-bottom: 14px;
  box-shadow: var(--shadow-card);
  transition: all var(--dur-slow) var(--ease);
  position: relative;
  overflow: hidden;
}

.card.active {
  border-color: var(--accent);
  box-shadow: var(--shadow-active);
  background: var(--card);
}

.card.active::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 4px;
  height: 100%;
  background: var(--accent);
  border-radius: 0 2px 2px 0;
}

.card.done {
  opacity: 0.45;
  border-color: var(--border);
  box-shadow: none;
  padding: 16px 24px;
}

.card.upcoming {
  opacity: 0.25;
  transform: scale(0.98);
}

.card h3 {
  font-size: 1.1rem;
  font-weight: 700;
  margin-bottom: 4px;
  line-height: 1.3;
  letter-spacing: -0.01em;
}

.card .meta {
  color: var(--muted);
  font-size: 0.82rem;
  margin-bottom: 12px;
  font-weight: 500;
}

/* --- Technique Block --- */
.tech {
  background: var(--accent-bg);
  border-left: 3px solid var(--accent);
  padding: 14px 18px;
  font-size: 0.84rem;
  color: var(--text);
  line-height: 1.7;
  margin: 14px 0;
  border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
}

/* --- Previous Result Hint --- */
.prev-result {
  background: var(--warm-bg);
  border-left: 3px solid var(--orange);
  padding: 12px 16px;
  font-size: 0.84rem;
  color: var(--text);
  line-height: 1.5;
  margin: 12px 0;
  border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  font-weight: 500;
}

/* --- Tags --- */
.tag {
  display: inline-block;
  padding: 4px 12px;
  border-radius: var(--radius-pill);
  font-size: 0.65rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  margin-bottom: 12px;
}

.tag-warmup   { background: var(--warm-bg); color: var(--orange); border: 1px solid rgba(217,119,6,0.2); }
.tag-exercise { background: var(--exercise-bg); color: var(--red); border: 1px solid rgba(220,38,38,0.15); }
.tag-cooldown { background: var(--cool-bg); color: var(--blue); border: 1px solid rgba(37,99,235,0.15); }

/* --- Checklist --- */
.check-item {
  display: flex;
  align-items: flex-start;
  gap: 14px;
  padding: 16px 0;
  border-bottom: 1px solid var(--border);
  font-size: 0.92rem;
}

.check-item:last-child { border: none; }

.check-item input[type="checkbox"] {
  width: 22px;
  height: 22px;
  accent-color: var(--accent);
  margin-top: 2px;
  flex-shrink: 0;
  cursor: pointer;
  border-radius: var(--radius-xs);
}

.check-item.checked .ci-text {
  text-decoration: line-through;
  color: var(--tertiary);
}

.ci-content { flex: 1; }

.ci-text {
  display: block;
  font-weight: 600;
  font-size: 0.92rem;
  line-height: 1.4;
}

.ci-desc {
  display: block;
  font-size: 0.8rem;
  color: var(--muted);
  margin-top: 5px;
  line-height: 1.55;
}

/* --- Inline Timer --- */
.ci-timer {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  margin-top: 10px;
}

.ci-timer-btn {
  background: var(--accent);
  color: #fff;
  border: none;
  border-radius: var(--radius-sm);
  padding: 7px 16px;
  font-size: 0.82rem;
  font-weight: 700;
  cursor: pointer;
  transition: background var(--dur) var(--ease), transform 100ms;
}

.ci-timer-btn:active { transform: scale(0.95); }
.ci-timer-btn.running { background: var(--orange); }
.ci-timer-btn.finished { background: var(--tertiary); }

.ci-timer-display {
  font-size: 1.05rem;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  min-width: 48px;
  color: var(--accent);
  transition: color var(--dur);
}

.ci-timer-display.warn { color: var(--orange); }
.ci-timer-display.end  { color: var(--red); }

/* --- Buttons --- */
.btn {
  display: block;
  width: 100%;
  padding: 16px;
  border: none;
  border-radius: var(--radius);
  font-size: 0.95rem;
  font-weight: 700;
  cursor: pointer;
  transition: background var(--dur) var(--ease), transform 100ms, box-shadow var(--dur);
  -webkit-tap-highlight-color: transparent;
  letter-spacing: 0.01em;
}

.btn:active { transform: scale(0.97); }
.btn:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }

.btn-go {
  background: var(--accent);
  color: #fff;
  box-shadow: 0 2px 8px rgba(13,150,104,0.25);
}
.btn-go:hover { background: var(--accent-hover); }

.btn-save {
  background: var(--blue);
  color: #fff;
  margin-top: 16px;
  box-shadow: 0 2px 8px rgba(37,99,235,0.25);
}

.btn-skip {
  background: var(--bg-secondary);
  color: var(--muted);
  border: 1px solid var(--border);
  margin-top: 8px;
  font-weight: 600;
}

.btn-tempo {
  background: var(--blue);
  color: #fff;
  margin-top: 12px;
  font-size: 0.88rem;
  padding: 14px;
  box-shadow: 0 2px 8px rgba(37,99,235,0.2);
}

/* --- Target Number --- */
.target-number {
  text-align: center;
  padding: 16px 0 12px;
}

.target-number .num {
  font-size: 3rem;
  font-weight: 800;
  color: var(--accent);
  line-height: 1;
  letter-spacing: -0.04em;
}

.target-number .label {
  font-size: 0.78rem;
  color: var(--muted);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  margin-top: 4px;
}

/* --- Rest Timer --- */
.timer {
  text-align: center;
  padding: 24px 0;
}

.timer-display {
  font-size: 3.5rem;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
  color: var(--accent);
  line-height: 1;
  letter-spacing: -0.03em;
}

.timer-display.warn { color: var(--orange); }
.timer-display.end  { color: var(--red); animation: pulse 0.5s infinite alternate; }

.timer-label {
  color: var(--muted);
  font-size: 0.88rem;
  margin-bottom: 10px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

@keyframes pulse { to { opacity: 0.4; } }

/* --- Tempo Timer --- */
.tempo-box {
  text-align: center;
  padding: 20px 0;
  margin: 10px 0;
  background: var(--bg-secondary);
  border-radius: var(--radius);
}

.tempo-phase {
  font-size: 2rem;
  font-weight: 800;
  margin-bottom: 4px;
}

.tempo-phase.phase-down { color: var(--blue); }
.tempo-phase.phase-hold { color: var(--orange); }
.tempo-phase.phase-up   { color: var(--accent); }
.tempo-count {
  font-size: 0.85rem;
  color: var(--muted);
  font-weight: 600;
}

/* --- Reps & Notes Input --- */
.reps-row {
  display: flex;
  align-items: center;
  gap: 14px;
  margin: 16px 0;
}

.reps-row label {
  font-size: 0.88rem;
  font-weight: 600;
  color: var(--muted);
}

.reps-input {
  background: var(--bg);
  border: 2px solid var(--border);
  color: var(--text);
  border-radius: var(--radius-sm);
  padding: 12px 16px;
  font-size: 1.3rem;
  width: 100px;
  text-align: center;
  font-weight: 800;
  font-family: inherit;
  transition: border-color var(--dur) var(--ease);
}

.reps-input:focus {
  outline: none;
  border-color: var(--accent);
}

.note-input {
  background: var(--bg);
  border: 1px solid var(--border);
  color: var(--text);
  border-radius: var(--radius-sm);
  padding: 12px 14px;
  font-size: 0.84rem;
  font-family: inherit;
  width: 100%;
  margin-top: 10px;
  transition: border-color var(--dur) var(--ease);
}

.note-input:focus {
  outline: none;
  border-color: var(--accent);
}

.note-input::placeholder,
.reps-input::placeholder {
  color: var(--tertiary);
}

/* --- Difficulty --- */
.diff-row {
  display: flex;
  align-items: center;
  gap: 8px;
  margin: 16px 0;
  flex-wrap: wrap;
}

.diff-row label {
  font-size: 0.88rem;
  font-weight: 600;
  color: var(--muted);
  width: 100%;
  margin-bottom: 4px;
}

.diff-btn {
  flex: 1;
  padding: 10px 12px;
  border-radius: var(--radius-sm);
  border: 2px solid var(--border);
  background: var(--bg);
  font-size: 0.85rem;
  font-weight: 700;
  cursor: pointer;
  transition: all var(--dur) var(--ease);
  text-align: center;
}

.diff-btn:hover { border-color: var(--border-strong); }
.diff-btn.selected { color: #fff; }
.diff-btn.sel-easy   { background: var(--accent); border-color: var(--accent); box-shadow: 0 2px 8px rgba(13,150,104,0.3); }
.diff-btn.sel-normal { background: var(--orange); border-color: var(--orange); box-shadow: 0 2px 8px rgba(217,119,6,0.3); }
.diff-btn.sel-hard   { background: var(--red); border-color: var(--red); box-shadow: 0 2px 8px rgba(220,38,38,0.3); }

/* --- Weight --- */
.weight-row {
  display: flex;
  align-items: center;
  gap: 12px;
  margin: 20px 0;
}

.weight-row label { font-size: 0.85rem; font-weight: 600; color: var(--muted); }

.weight-input {
  background: var(--bg);
  border: 2px solid var(--border);
  color: var(--text);
  border-radius: var(--radius-sm);
  padding: 10px 14px;
  font-size: 1.1rem;
  width: 100px;
  text-align: center;
  font-weight: 700;
  font-family: inherit;
  transition: border-color var(--dur) var(--ease);
}

.weight-input:focus { outline: none; border-color: var(--accent); }
.weight-unit { font-size: 0.82rem; color: var(--muted); font-weight: 600; }

/* --- Summary --- */
.summary-table {
  width: 100%;
  border-collapse: collapse;
  margin: 20px 0;
}

.summary-table th,
.summary-table td {
  padding: 10px 8px;
  font-size: 0.8rem;
  text-align: left;
  border-bottom: 1px solid var(--border);
}

.summary-table th {
  color: var(--muted);
  font-weight: 600;
  text-transform: uppercase;
  font-size: 0.7rem;
  letter-spacing: 0.06em;
}

.good { color: var(--accent); font-weight: 700; }
.miss { color: var(--red); font-weight: 700; }

.final-notes {
  background: var(--bg);
  border: 2px solid var(--border);
  color: var(--text);
  border-radius: var(--radius-sm);
  padding: 14px;
  font-size: 0.85rem;
  font-family: inherit;
  width: 100%;
  min-height: 80px;
  resize: vertical;
  margin-top: 10px;
  transition: border-color var(--dur) var(--ease);
}

.final-notes:focus { outline: none; border-color: var(--accent); }

/* --- Progression Recommendation --- */
.prog-rec {
  background: var(--accent-bg);
  border: 1px solid var(--accent);
  border-radius: var(--radius);
  padding: 16px 18px;
  margin: 16px 0;
  font-size: 0.85rem;
  line-height: 1.65;
}

.prog-rec strong { color: var(--accent); }

/* --- Utility --- */
.hidden { display: none; }
.done-badge { color: var(--accent); font-size: 0.8rem; margin-left: 6px; }

/* --- Elapsed Timer --- */
.elapsed-timer {
  text-align: center;
  font-size: 0.95rem;
  font-weight: 600;
  color: var(--muted);
  margin-bottom: 20px;
  font-variant-numeric: tabular-nums;
  letter-spacing: 0.03em;
  padding: 10px;
  background: var(--bg-secondary);
  border-radius: var(--radius-sm);
}

/* --- Start Button --- */
.btn-start {
  background: var(--accent);
  color: #fff;
  font-size: 1.2rem;
  font-weight: 800;
  padding: 22px;
  border-radius: var(--radius);
  margin: 28px 0;
  box-shadow: 0 4px 20px rgba(13,150,104,0.3);
  animation: pulse-start 2.5s ease-in-out infinite;
  letter-spacing: 0.01em;
}

@keyframes pulse-start {
  0%, 100% { box-shadow: 0 4px 20px rgba(13,150,104,0.3); }
  50% { box-shadow: 0 4px 36px rgba(13,150,104,0.5); }
}

/* --- Card Entrance Animation --- */
@keyframes card-in {
  from {
    opacity: 0;
    transform: translateY(12px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.card {
  animation: card-in var(--dur-slow) var(--ease) both;
}

.card:nth-child(1) { animation-delay: 0ms; }
.card:nth-child(2) { animation-delay: 60ms; }
.card:nth-child(3) { animation-delay: 120ms; }
.card:nth-child(4) { animation-delay: 180ms; }
.card:nth-child(5) { animation-delay: 240ms; }
.card:nth-child(6) { animation-delay: 300ms; }
.card:nth-child(7) { animation-delay: 360ms; }
.card:nth-child(8) { animation-delay: 420ms; }
.card:nth-child(9) { animation-delay: 480ms; }
.card:nth-child(10) { animation-delay: 540ms; }
