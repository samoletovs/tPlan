/* ============================================================
   Tplan — Design System v3 (Skill Applied)
   Following design-system SKILL.md prescriptions exactly:
   - Accent: #2563EB (blue) not green
   - Font: Inter (Google Fonts)
   - Warm white bg #FAFAF9
   - 8px spacing rhythm
   - Consistent 12px radius
   - Staggered card animations
   - Dark mode via prefers-color-scheme
   - prefers-reduced-motion support
   ============================================================ */

@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  /* Skill-prescribed color system */
  --bg:           #FAFAF9;
  --bg-secondary: #F3F2F0;
  --bg-tertiary:  #EBEAE8;
  --card:         #FFFFFF;
  --border:       #E5E4E2;
  --border-strong:#D1D0CE;
  --text:         #1A1A19;
  --muted:        #6B6A68;
  --tertiary:     #9B9A98;

  /* Accent = blue per skill (not green!) */
  --accent:       #2563EB;
  --accent-hover: #1D4ED8;
  --accent-bg:    #EFF6FF;
  --accent-glow:  rgba(37,99,235,0.12);

  /* Semantic colors */
  --success:      #16A34A;
  --success-bg:   #F0FDF4;
  --warning:      #D97706;
  --warning-bg:   #FFFBEB;
  --error:        #DC2626;
  --error-bg:     #FEF2F2;
  --info:         #0EA5E9;
  --info-bg:      #F0F9FF;

  /* Mapped for backward compat */
  --red:          var(--error);
  --orange:       var(--warning);
  --blue:         var(--accent);
  --blue-bg:      var(--accent-bg);
  --warm-bg:      var(--warning-bg);
  --cool-bg:      #EEF2FF;
  --exercise-bg:  var(--error-bg);

  /* Shadows — subtle, warm per skill */
  --shadow-xs:    0 1px 2px rgba(0,0,0,0.04);
  --shadow-sm:    0 1px 3px rgba(0,0,0,0.06), 0 1px 2px rgba(0,0,0,0.04);
  --shadow-md:    0 4px 6px rgba(0,0,0,0.05), 0 2px 4px rgba(0,0,0,0.04);
  --shadow-lg:    0 10px 15px rgba(0,0,0,0.06), 0 4px 6px rgba(0,0,0,0.04);
  --shadow-active:0 0 0 2px var(--accent), 0 8px 25px var(--accent-glow);

  /* Spacing — 4px base, 8px rhythm per skill */
  --space-1: 0.25rem;
  --space-2: 0.5rem;
  --space-3: 0.75rem;
  --space-4: 1rem;
  --space-5: 1.25rem;
  --space-6: 1.5rem;
  --space-8: 2rem;

  /* Radius — consistent per skill */
  --radius:       0.75rem;   /* 12px — cards */
  --radius-sm:    0.5rem;    /* 8px — buttons, inputs */
  --radius-pill:  9999px;

  /* Motion — per skill */
  --ease:         cubic-bezier(0.25, 0.1, 0.25, 1);
  --ease-spring:  cubic-bezier(0.34, 1.56, 0.64, 1);
  --dur-fast:     100ms;
  --dur:          200ms;
  --dur-slow:     300ms;

  /* Typography */
  --font:         'Inter', system-ui, -apple-system, sans-serif;
  --leading:      1.5;
  --leading-tight:1.25;
}

/* Dark theme — per skill */
@media (prefers-color-scheme: dark) {
  :root {
    --bg:           #141413;
    --bg-secondary: #1E1E1D;
    --bg-tertiary:  #282827;
    --card:         #1E1E1D;
    --border:       #2E2E2D;
    --border-strong:#3E3E3D;
    --text:         #F0EFED;
    --muted:        #A3A2A0;
    --tertiary:     #6B6A68;
    --accent:       #60A5FA;
    --accent-hover: #93C5FD;
    --accent-bg:    #1E293B;
    --accent-glow:  rgba(96,165,250,0.12);
    --success:      #4ADE80;
    --warning:      #FBBF24;
    --error:        #F87171;
    --shadow-xs:    none;
    --shadow-sm:    0 0 0 1px var(--border);
    --shadow-md:    none;
    --shadow-lg:    none;
    --shadow-active:0 0 0 2px var(--accent);
  }
}

/* Respect reduced motion — per skill */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    transition-duration: 0.01ms !important;
  }
}

/* ===== BASE ===== */
body {
  font-family: var(--font);
  background: var(--bg);
  color: var(--text);
  max-width: 540px;
  margin: 0 auto;
  padding: var(--space-8) var(--space-5);
  min-height: 100vh;
  font-size: 1rem;           /* 16px per skill (never smaller for body) */
  line-height: var(--leading);
  -webkit-font-smoothing: antialiased;
}

h1 {
  font-size: 1.563rem;       /* text-lg from skill scale */
  font-weight: 700;
  letter-spacing: -0.02em;
  line-height: var(--leading-tight);
  margin-bottom: var(--space-1);
}

h2 {
  font-size: 1.25rem;        /* text-md */
  font-weight: 600;
  letter-spacing: -0.01em;
}

.sub {
  color: var(--muted);
  font-size: 0.8rem;         /* text-sm */
  margin-bottom: var(--space-6);
  line-height: var(--leading);
}

/* ===== STREAK ===== */
.streak {
  text-align: center;
  padding: var(--space-3) var(--space-5);
  background: var(--accent-bg);
  border: 1px solid var(--accent);
  border-radius: var(--radius);
  font-size: 0.9rem;
  font-weight: 600;
  color: var(--accent);
  margin-bottom: var(--space-5);
}

/* ===== PROGRESS ===== */
.prog {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  margin-bottom: var(--space-6);
}

.prog-bar {
  flex: 1;
  height: 6px;
  background: var(--bg-tertiary);
  border-radius: var(--radius-pill);
  overflow: hidden;
}

.prog-fill {
  height: 100%;
  background: var(--accent);
  border-radius: var(--radius-pill);
  transition: width 0.4s var(--ease);
}

.prog-text {
  font-size: 0.8rem;
  font-weight: 600;
  color: var(--muted);
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
}

/* ===== CARDS ===== */
.card {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: var(--space-5);
  margin-bottom: var(--space-3);
  box-shadow: var(--shadow-sm);
  transition: all var(--dur-slow) var(--ease);
  position: relative;
}

.card.active {
  border-color: var(--accent);
  box-shadow: var(--shadow-active);
}

.card.active::before {
  content: '';
  position: absolute;
  top: 0; left: 0;
  width: 4px; height: 100%;
  background: var(--accent);
  border-radius: 0 var(--space-1) var(--space-1) 0;
}

.card.done {
  opacity: 0.45;
  border-color: var(--border);
  box-shadow: none;
  padding: var(--space-4) var(--space-5);
}

.card.upcoming {
  opacity: 0.25;
}

.card h3 {
  font-size: 1.1rem;
  font-weight: 700;
  margin-bottom: var(--space-1);
  line-height: var(--leading-tight);
}

.card .meta {
  color: var(--muted);
  font-size: 0.8rem;
  font-weight: 500;
  margin-bottom: var(--space-3);
}

/* ===== TECHNIQUE ===== */
.tech {
  background: var(--accent-bg);
  border-left: 3px solid var(--accent);
  padding: var(--space-3) var(--space-4);
  font-size: 0.875rem;
  color: var(--text);
  line-height: 1.7;
  margin: var(--space-3) 0;
  border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
}

/* ===== PREVIOUS RESULT ===== */
.prev-result {
  background: var(--warning-bg);
  border-left: 3px solid var(--warning);
  padding: var(--space-3) var(--space-4);
  font-size: 0.875rem;
  font-weight: 500;
  color: var(--text);
  line-height: var(--leading);
  margin: var(--space-3) 0;
  border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
}

/* ===== TAGS ===== */
.tag {
  display: inline-flex;
  align-items: center;
  padding: var(--space-1) var(--space-3);
  border-radius: var(--radius-sm);
  font-size: 0.65rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  margin-bottom: var(--space-3);
}

.tag-warmup   { background: var(--warning-bg); color: var(--warning); }
.tag-exercise { background: var(--error-bg); color: var(--error); }
.tag-cooldown { background: var(--cool-bg); color: var(--accent); }

/* ===== CHECKLIST ===== */
.check-item {
  display: flex;
  align-items: flex-start;
  gap: var(--space-3);
  padding: var(--space-4) 0;
  border-bottom: 1px solid var(--border);
}

.check-item:last-child { border: none; }

.check-item input[type="checkbox"] {
  width: 20px;
  height: 20px;
  accent-color: var(--accent);
  margin-top: 3px;
  flex-shrink: 0;
  cursor: pointer;
}

.check-item.checked .ci-text {
  text-decoration: line-through;
  color: var(--tertiary);
}

.ci-content { flex: 1; }

.ci-text {
  display: block;
  font-weight: 600;
  font-size: 0.9rem;
  line-height: 1.4;
}

.ci-desc {
  display: block;
  font-size: 0.8rem;
  color: var(--muted);
  margin-top: var(--space-1);
  line-height: var(--leading);
}

/* ===== INLINE TIMER ===== */
.ci-timer {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  margin-top: var(--space-2);
}

.ci-timer-btn {
  background: var(--accent);
  color: #fff;
  border: none;
  border-radius: var(--radius-sm);
  padding: 6px 14px;
  font-size: 0.82rem;
  font-weight: 700;
  cursor: pointer;
  transition: background var(--dur-fast), transform var(--dur-fast);
}

.ci-timer-btn:active { transform: scale(0.95); }
.ci-timer-btn.running { background: var(--warning); }
.ci-timer-btn.finished { background: var(--tertiary); }

.ci-timer-display {
  font-size: 1rem;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  min-width: 44px;
  color: var(--accent);
}

.ci-timer-display.warn { color: var(--warning); }
.ci-timer-display.end  { color: var(--error); }

/* ===== BUTTONS ===== */
.btn {
  display: block;
  width: 100%;
  padding: var(--space-4);
  border: none;
  border-radius: var(--radius-sm);
  font-size: 0.95rem;
  font-weight: 700;
  cursor: pointer;
  transition: background var(--dur), transform var(--dur-fast), box-shadow var(--dur);
  -webkit-tap-highlight-color: transparent;
}

.btn:active { transform: scale(0.97); }
.btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

.btn-go {
  background: var(--accent);
  color: #fff;
  box-shadow: 0 2px 8px var(--accent-glow);
}
.btn-go:hover { background: var(--accent-hover); }

.btn-save {
  background: var(--accent);
  color: #fff;
  margin-top: var(--space-4);
  box-shadow: 0 2px 8px var(--accent-glow);
}

.btn-skip {
  background: var(--bg-secondary);
  color: var(--muted);
  border: 1px solid var(--border);
  margin-top: var(--space-2);
}

.btn-tempo {
  background: var(--bg-tertiary);
  color: var(--text);
  margin-top: var(--space-3);
  font-size: 0.88rem;
  padding: var(--space-3);
  border: 1px solid var(--border);
}

/* ===== TARGET NUMBER ===== */
.target-number {
  text-align: center;
  padding: var(--space-5) 0 var(--space-3);
}

.target-number .num {
  font-size: 3.5rem;
  font-weight: 800;
  color: var(--accent);
  line-height: 1;
  letter-spacing: -0.04em;
}

.target-number .label {
  font-size: 0.7rem;
  color: var(--muted);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  margin-top: var(--space-1);
}

/* ===== REST TIMER ===== */
.timer { text-align: center; padding: var(--space-5) 0; }

.timer-display {
  font-size: 3.5rem;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
  color: var(--accent);
  line-height: 1;
}

.timer-display.warn { color: var(--warning); }
.timer-display.end  { color: var(--error); animation: pulse 0.5s infinite alternate; }

.timer-label {
  color: var(--muted);
  font-size: 0.85rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  margin-bottom: var(--space-2);
}

@keyframes pulse { to { opacity: 0.4; } }

/* ===== TEMPO ===== */
.tempo-box {
  text-align: center;
  padding: var(--space-4);
  margin: var(--space-3) 0;
  background: var(--bg-secondary);
  border-radius: var(--radius);
  border: 1px solid var(--border);
}

.tempo-phase { font-size: 1.8rem; font-weight: 800; margin-bottom: 4px; }
.tempo-phase.phase-down { color: var(--accent); }
.tempo-phase.phase-hold { color: var(--warning); }
.tempo-phase.phase-up   { color: var(--success); }
.tempo-count { font-size: 0.85rem; color: var(--muted); font-weight: 600; }

/* ===== INPUTS ===== */
.reps-row {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  margin: var(--space-4) 0;
}

.reps-row label {
  font-size: 0.88rem;
  font-weight: 600;
  color: var(--muted);
}

.reps-input {
  background: var(--bg-secondary);
  border: 2px solid var(--border);
  color: var(--text);
  border-radius: var(--radius-sm);
  padding: var(--space-3) var(--space-4);
  font-size: 1.3rem;
  width: 100px;
  text-align: center;
  font-weight: 800;
  font-family: inherit;
  transition: border-color var(--dur);
}

.reps-input:focus { outline: none; border-color: var(--accent); }

.note-input {
  background: var(--bg-secondary);
  border: 1px solid var(--border);
  color: var(--text);
  border-radius: var(--radius-sm);
  padding: var(--space-3);
  font-size: 0.84rem;
  font-family: inherit;
  width: 100%;
  margin-top: var(--space-2);
  transition: border-color var(--dur);
}

.note-input:focus { outline: none; border-color: var(--accent); }
.note-input::placeholder, .reps-input::placeholder { color: var(--tertiary); }

/* ===== DIFFICULTY ===== */
.diff-row {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  margin: var(--space-4) 0;
  flex-wrap: wrap;
}

.diff-row label {
  font-size: 0.88rem;
  font-weight: 600;
  color: var(--muted);
  width: 100%;
  margin-bottom: var(--space-1);
}

.diff-btn {
  flex: 1;
  padding: var(--space-2) var(--space-3);
  border-radius: var(--radius-sm);
  border: 2px solid var(--border);
  background: var(--bg-secondary);
  font-size: 0.85rem;
  font-weight: 700;
  cursor: pointer;
  text-align: center;
  transition: all var(--dur);
}

.diff-btn:hover { border-color: var(--border-strong); }
.diff-btn.selected { color: #fff; }
.diff-btn.sel-easy   { background: var(--success); border-color: var(--success); }
.diff-btn.sel-normal { background: var(--warning); border-color: var(--warning); }
.diff-btn.sel-hard   { background: var(--error); border-color: var(--error); }

/* ===== WEIGHT ===== */
.weight-row {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  margin: var(--space-5) 0;
}

.weight-row label { font-size: 0.85rem; font-weight: 600; color: var(--muted); }

.weight-input {
  background: var(--bg-secondary);
  border: 2px solid var(--border);
  color: var(--text);
  border-radius: var(--radius-sm);
  padding: var(--space-3);
  font-size: 1.1rem;
  width: 100px;
  text-align: center;
  font-weight: 700;
  font-family: inherit;
  transition: border-color var(--dur);
}

.weight-input:focus { outline: none; border-color: var(--accent); }
.weight-unit { font-size: 0.82rem; color: var(--muted); font-weight: 600; }

/* ===== SUMMARY ===== */
.summary-table { width: 100%; border-collapse: collapse; margin: var(--space-5) 0; }

.summary-table th,
.summary-table td {
  padding: var(--space-2) var(--space-2);
  font-size: 0.8rem;
  text-align: left;
  border-bottom: 1px solid var(--border);
}

.summary-table th {
  color: var(--muted);
  font-weight: 700;
  text-transform: uppercase;
  font-size: 0.65rem;
  letter-spacing: 0.08em;
}

.good { color: var(--success); font-weight: 700; }
.miss { color: var(--error); font-weight: 700; }

.final-notes {
  background: var(--bg-secondary);
  border: 2px solid var(--border);
  color: var(--text);
  border-radius: var(--radius-sm);
  padding: var(--space-3);
  font-size: 0.85rem;
  font-family: inherit;
  width: 100%;
  min-height: 80px;
  resize: vertical;
  margin-top: var(--space-2);
  transition: border-color var(--dur);
}

.final-notes:focus { outline: none; border-color: var(--accent); }

/* ===== PROGRESSION REC ===== */
.prog-rec {
  background: var(--accent-bg);
  border: 1px solid var(--accent);
  border-radius: var(--radius);
  padding: var(--space-4);
  margin: var(--space-4) 0;
  font-size: 0.85rem;
  line-height: 1.65;
}

.prog-rec strong { color: var(--accent); }

/* ===== UTILITY ===== */
.hidden { display: none; }
.done-badge { color: var(--success); font-size: 0.8rem; margin-left: var(--space-1); }

/* ===== ELAPSED ===== */
.elapsed-timer {
  text-align: center;
  font-size: 0.88rem;
  font-weight: 600;
  color: var(--muted);
  margin-bottom: var(--space-5);
  font-variant-numeric: tabular-nums;
  padding: var(--space-2) var(--space-4);
  background: var(--bg-secondary);
  border-radius: var(--radius-sm);
  display: inline-block;
  width: 100%;
}

/* ===== START ===== */
.btn-start {
  background: var(--accent);
  color: #fff;
  font-size: 1.15rem;
  font-weight: 800;
  padding: var(--space-6);
  border-radius: var(--radius);
  margin: var(--space-6) 0;
  box-shadow: 0 4px 24px var(--accent-glow);
  animation: pulse-start 2.5s ease-in-out infinite;
}

@keyframes pulse-start {
  0%, 100% { box-shadow: 0 4px 20px var(--accent-glow); }
  50% { box-shadow: 0 4px 40px rgba(37,99,235,0.35); }
}

/* ===== CARD ENTRANCE ===== */
@keyframes card-in {
  from { opacity: 0; transform: translateY(8px); }
  to   { opacity: 1; transform: translateY(0); }
}

.card { animation: card-in var(--dur-slow) var(--ease) both; }
.card:nth-child(1) { animation-delay: 0ms; }
.card:nth-child(2) { animation-delay: 50ms; }
.card:nth-child(3) { animation-delay: 100ms; }
.card:nth-child(4) { animation-delay: 150ms; }
.card:nth-child(5) { animation-delay: 200ms; }
.card:nth-child(6) { animation-delay: 250ms; }
.card:nth-child(7) { animation-delay: 300ms; }
.card:nth-child(8) { animation-delay: 350ms; }
.card:nth-child(9) { animation-delay: 400ms; }
.card:nth-child(10){ animation-delay: 450ms; }
