# ──────────────────────────────────────────────────────────────────────
# tPlan Environment Variables
#
# Copy to .env for local development.
# In production, API env vars are set via Azure SWA App Settings.
# ──────────────────────────────────────────────────────────────────────

# ── Azure Table Storage ──
STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net

# ── Azure OpenAI (workout generation fallback) ──
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# ── GitHub (issue integration) ──
GITHUB_TOKEN=
GITHUB_REPO=samoletovs/tplan

# ── Application Insights (optional) ──
APPLICATIONINSIGHTS_CONNECTION_STRING=

# ── Telegram Notifications (track-login runtime only — family bot) ──
# Used by api/src/functions/track-login.ts to record user sign-ins.
# For CI/CD deploy notifications the workflow uses org-level secrets
# NAURO_BOT_TOKEN + NAURO_CHAT_ID (new nauroLabs ops bot) — see PLATFORM.md §8.
TELEGRAM_NOTIFY_URL=
